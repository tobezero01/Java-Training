    {
      "name": "Payments – PayPal",
      "item": [
        {
          "name": "Create PayPal order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "orderNumber",
                  "value": "OD20250101-000001"
                },
                {
                  "key": "amount",
                  "value": "{{amount}}"
                },
                {
                  "key": "currency",
                  "value": "{{currency}}"
                },
                {
                  "key": "returnUrl",
                  "value": "http://localhost:8080/paypal/return"
                },
                {
                  "key": "cancelUrl",
                  "value": "http://localhost:8080/paypal/cancel"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/paypal/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "paypal",
                "create"
              ]
            }
          }
        },
        {
          "name": "Capture PayPal order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "paypalOrderId",
                  "value": "{{paypalOrderId}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/paypal/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "paypal",
                "capture"
              ]
            }
          }
        },
        {
          "name": "Validate PayPal order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "paypalOrderId",
                  "value": "{{paypalOrderId}}"
                },
                {
                  "key": "expectedAmount",
                  "value": "{{amount}}"
                },
                {
                  "key": "expectedCurrency",
                  "value": "{{currency}}"
                },
                {
                  "key": "referenceId",
                  "value": "OD20250101-000001"
                },
                {
                  "key": "requireCompleted",
                  "value": "true"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/paypal/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "paypal",
                "validate"
              ]
            }
          }
        }
      ]
