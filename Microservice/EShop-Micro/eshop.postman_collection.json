{
  "info": {
    "name": "EShop Microservices – Full API",
    "_postman_id": "a6d947c0-2a0d-42db-9a3c-a0a0889331d4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection covering gateway-routed APIs for auth, catalog, cart, checkout, payment, orders (events are Kafka-based), addresses, and geo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "paypalOrderId",
      "value": ""
    },
    {
      "key": "currency",
      "value": "USD"
    },
    {
      "key": "amount",
      "value": "10.00"
