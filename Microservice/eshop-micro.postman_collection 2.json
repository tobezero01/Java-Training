  "item": [
    {
      "name": "SERVERS — Health & Info",
      "item": [
        {
          "name": "Eureka — UI (/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseEureka}}/"
          },
          "response": []
        },
        {
          "name": "Eureka — /actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseEureka}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Contains UP', function () { pm.expect(pm.response.text()).to.include('UP'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Config Server — /actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseConfig}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 & UP',()=>{pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('UP');});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Config Server — auth-service config (default profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseConfig}}/auth-service/default"
          },
          "response": []
        },
        {
          "name": "Gateway — /actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gateway UP',()=>{pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('UP');});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth-Service (direct) — /actuator/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseAuth}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Auth-Service UP',()=>{pm.response.to.have.status(200); pm.expect(pm.response.text()).to.include('UP');});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AUTH via Gateway — End-to-End",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseGateway}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"{{firstName}}\", \"lastName\": \"{{lastName}}\", \"email\": \"{{email}}\", \"password\": \"{{password}}\", \"countryCode\": \"{{countryCode}}\", \"addressLine1\": \"{{addressLine1}}\", \"addressLine2\": \"{{addressLine2}}\", \"city\": \"{{city}}\", \"state\": \"{{state}}\", \"postalCode\": \"{{postalCode}}\", \"phone\": \"{{phone}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registered (200)',()=>pm.response.to.have.status(200));",
                  "// If verification code is printed in dev logs, set it manually to {{verificationCode}} when testing verify."
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify (dev: paste code to {{verificationCode}})",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/auth/verify?code={{verificationCode}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verify OK',()=>pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseGateway}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"rememberMe\": true}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200',()=>pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "if(data && data.accessToken){ pm.collectionVariables.set('accessToken', data.accessToken); }",
                  "pm.test('accessToken saved',()=> pm.collectionVariables.get('accessToken'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me (Bearer {{accessToken}})",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Me 200',()=>pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh (uses HttpOnly cookie)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseGateway}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh 200',()=>pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "if(data && data.accessToken){ pm.collectionVariables.set('accessToken', data.accessToken); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout (revoke + clear cookie)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseGateway}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout 204',()=>pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseGateway}}/api/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Forgot 200',()=>pm.response.to.have.status(200));",
                  "// Set {{resetToken}} from email/log for Reset Password step."
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseGateway}}/api/auth/reset-password",
            "body": {
              "mode": "raw",
              "raw": "{\"token\": \"{{resetToken}}\", \"newPassword\": \"NewPassword@123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reset OK',()=>pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CATALOG via Gateway",
      "item": [
        {
          "name": "Categories — Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/categories/tree"
          }
        },
        {
          "name": "Categories — Top Level",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/categories/top-level"
          }
        },
        {
          "name": "Categories — Leaves",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/categories/leaf"
          }
        },
        {
          "name": "Category — By Alias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/categories/alias/{{categoryAlias}}"
          }
        },
        {
          "name": "Category — Parents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/categories/{{catId}}/parents"
          }
        },
        {
          "name": "Product — By Alias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/products/alias/{{productAlias}}"
          }
        },
        {
          "name": "Product — By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/products/{{productId}}"
          }
        },
        {
          "name": "Products — By Category (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/products/by-category/{{catId}}?page=1&sort=name&dir=asc"
          }
        },
        {
          "name": "Products — Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/products/search?keyword=phone&page=1"
          }
        }
      ]
    },
    {
      "name": "CART via Gateway",
      "item": [
        {
          "name": "Cart — Add Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\": \"{{productId}}\", \"quantity\": 1}"
            }
          }
        },
        {
          "name": "Cart — Update Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/cart/items/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\": 2}"
            }
          }
        },
        {
          "name": "Cart — Remove Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/cart/items/{{productId}}"
          }
        },
        {
          "name": "Cart — Clear",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/cart"
          }
        }
      ]
    },
    {
      "name": "CHECKOUT via Gateway",
      "item": [
        {
          "name": "Checkout — Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/checkout/summary?addressId={{addressId}}"
          }
        },
        {
          "name": "Checkout — Place Order (COD)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/checkout/place-order",
            "body": {
              "mode": "raw",
              "raw": "{\"addressId\": \"{{addressId}}\", \"paymentMethod\": \"COD\", \"note\": \"Please ship fast\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Placed OK', function() { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.orderNumber) { pm.collectionVariables.set('orderNumber', json.orderNumber); pm.environment.set('orderNumber', json.orderNumber); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout — Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/checkout/cancel-order?orderNumber={{orderNumber}}&reason=User requested"
          }
        }
      ]
    },
    {
      "name": "GATEWAY — Smoke",
      "item": [
        {
          "name": "Smoke — /api/auth/me (Bearer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseGateway}}/api/auth/me"
          }
        },
        {
          "name": "Smoke — /api/products/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseGateway}}/api/products/{{productId}}"
          }
        }
      ]
    }
  ]
}