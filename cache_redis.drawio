<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36" version="28.2.5" pages="2">
  <diagram name="Page-1" id="qleVSZt7ZoTJCzBsNbUl">
    <mxGraphModel dx="1042" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="UkIZlLejCnLaWUFrefnl-1" value="mono" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="120" y="100" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UkIZlLejCnLaWUFrefnl-2" value="micro" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="480" y="100" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="UkIZlLejCnLaWUFrefnl-3" value="- Toàn bộ logic, xử lý đều nằm trên 1 app&lt;br&gt;- Đơn giản : quản lý, vận hành, giao tiếp giữa các luồng nghiệp vụ&lt;br&gt;- Nghiệp vụ đơn giản, hệ thống nhỏ, lượng người dùng cơ bản&lt;br&gt;- Nhược điểm :&amp;nbsp;&lt;br&gt;+ Một chức năng lỗi có thể gây lỗi toàn hệ thống&lt;br&gt;+ Khi muốn nâng cấp thì phải nâng cấp toàn bộ ứng dụng hiện tại&lt;br&gt;&lt;br&gt;- Ưu điểm&lt;br&gt;+ Việc quản lý transaction dễ dàng&lt;br&gt;+ giao tiếp giữa các service trong ứng dụng đơn giản" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="120" y="180" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="UkIZlLejCnLaWUFrefnl-4" value="- micro service là gì? : nghiệp vụ phức tạp, hệ thống lớn, lượng người dùng nhiều&lt;br&gt;hệ thống phân tán, bao gồm nhiều service nghiệp nhỏ liên kết với nhau&lt;br&gt;- tách từng nghiệp vụ thành một service độc lập. Ngôn ngữ không giới hạn, không bị giới hạn về csdl&lt;br&gt;- Khi muốn nâng cấp bất kỳ nghiệp vụ nào thì chỉ cần nâng cấp đúng service đó&lt;br&gt;&lt;br&gt;- Nhược điểm&lt;br&gt;+ Quản lý transaction khó&lt;br&gt;+ Các service cần phải có kênh để giai tiếp&lt;br&gt;+ Quản lý, vận hành, triển khai phức tạp hơn và tốn nhiều tài nguyên hơn" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="480" y="170" width="230" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
